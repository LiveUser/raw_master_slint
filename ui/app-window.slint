import { Button, VerticalBox, ScrollView, Slider } from "std-widgets.slint";

struct LUT {
    name:string,
    full_path:string,
}
component LutWidget inherits TouchArea {
    in property <LUT> lut;
    Text {
        text: lut.name;
    }
}

export component AppWindow inherits Window {
    in-out property <[LUT]> luts: [];
    in-out property <string> selected-lut:"No LUT selected";
    in-out property <int> files-being-processed:0;
    in-out property <float> quality:100;
    callback store-lut();
    callback select-lut(lut:LUT);
    callback process-raw-images(quality:float);
    callback clear-lut-selection();

    property <bool> luts_page_visible: false;

    width: 500px;
    height: 500px;

    VerticalBox {
        spacing: 20px;
        Rectangle {
            width: 100%;
            height: 50px;
            background: black;
            Text {
                text: "Raw Master";
                color: white;
            }
        }
        
        Button {
            text: "LUTs";
            height: 50px;
            clicked => {
                luts_page_visible = true;
            }
        }

        Button {
            text: "Process RAW images";
            height: 50px;
            clicked => {
                process-raw-images(quality);
            }
        }
        Text {
            text: "Quality " + quality + "%";
        }
        Slider {
            minimum: 0;
            maximum: 100;
            value: quality;
            changed(value) => {
                quality = value;
            }
        }
    }
    Rectangle {
        visible: luts_page_visible;
        background: white;
        VerticalBox {
            spacing: 20px;
            Rectangle {
                width: 100%;
                height: 50px;
                background: black;
                Text {
                    text: "Raw Master";
                    color: white;
                }
            }
            Button {
                text: "Back";
                height: 50px;
                clicked => {
                    luts_page_visible = false;
                }
            }
            Text {
                text: selected-lut == "" ? "No LUT selected" : selected-lut;
                horizontal-alignment: center;
            }
            Button {
                text: "Add LUT";
                height: 50px;
                clicked => {
                    store_lut();
                }
            }
            ScrollView {
                VerticalBox {
                    spacing: 10px;
                    Button {
                        text: "None";
                        clicked => {
                            clear-lut-selection();
                            selected-lut = "No LUT selected";
                        }
                    }
                    for lut in luts: LutWidget {
                        lut: lut;
                        clicked => {
                            select-lut(lut);
                            selected-lut = lut.name;
                        }
                    }
                }
            }
        }
    }
}
